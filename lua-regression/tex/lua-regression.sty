  {
    \keys_set:nn { luaregression }
      {
        x           = 1,
        y           = 2,
        ci          = false,
        z           = null,
        sf          = 4,
        order       = 1,
        type        = polynomial,
        lambda      = 1.0,
        standardize = true,
        quantile    = 0.5,
        max~iter    = null,
        tol         = null,
        nan         = true,
        zero        = false,
        missing     = true,
        plot        = false,
        pgf         = {mark=none,smooth},
        axis~pgf    = {},
        eq          = false,
        r2          = false,
        debug       = false,
        ci~boot     = 1000,
        ci~level    = 0.95,
        ci~color    = blue,
        ci~opacity  = 0.2,
        p           = false,
        lines       = {},
        xmin        = null,
        xmax        = null,
        ci~truncate = true,
        ci~min      = null,
        ci~max      = null,
        seed        = null,
        legend      = auto,
        linecolor   = black,
      }
  }

% Single helper to invoke Lua pipeline with current option state
\cs_new_protected:Npn \__luareg_call_lua:n #1
  {
    \lua_now:e
      {
        require("lua-regression")~
        process_data_with_options(
          #1,
          {
            ["x"]~=~tonumber("\lua_escape:e { \l__luareg_x_tl }"),
            ["y"]~=~tonumber("\lua_escape:e { \l__luareg_y_tl }"),
            ["z_threshold"]~=~tonumber("\lua_escape:e { \l__luareg_z_tl }"),
            ["sig_figures"]~=~tonumber("\lua_escape:e { \l__luareg_sf_tl }"),
            ["ci"]~=~\bool_if:NTF \l__luareg_ci_bool { true } { false },
            ["order"]~=~tonumber("\lua_escape:e { \l__luareg_order_tl }"),
            ["regression_type"]~=~"\lua_escape:e { \l__luareg_type_tl }",
            ["regression~type"]~=~"\lua_escape:e { \l__luareg_type_tl }",
            ["lambda"]~=~tonumber("\lua_escape:e { \l__luareg_lambda_tl }"),
            ["standardize"]~=~\bool_if:NTF \l__luareg_standardize_bool { true } { false },
            ["quantile"]~=~tonumber("\lua_escape:e { \l__luareg_quantile_tl }"),
            ["max_iter"]~=~tonumber("\lua_escape:e { \l__luareg_max_iter_tl }"),
            ["tol"]~=~tonumber("\lua_escape:e { \l__luareg_tol_tl }"),
            ["ignore_nan"]~=~\bool_if:NTF \l__luareg_nan_bool { true } { false },
            ["ignore_zero"]~=~\bool_if:NTF \l__luareg_zero_bool { true } { false },
            ["ignore_missing"]~=~\bool_if:NTF \l__luareg_missing_bool { true } { false },
            ["debug"]~=~\bool_if:NTF \l__luareg_debug_bool { true } { false },
            ["bootstrap_samples"]~=~tonumber("\lua_escape:e { \l__luareg_ci_boot_tl }"),
            ["lines"]~=~"\lua_escape:e { \l__luareg_lines_tl }",
            ["xmin"]~=~tonumber("\lua_escape:e { \l__luareg_xmin_tl }"),
            ["xmax"]~=~tonumber("\lua_escape:e { \l__luareg_xmax_tl }"),
            ["axis_xmin"]~=~tonumber("\lua_escape:e { \l__luareg_axis_xmin_tl }"),
            ["axis_xmax"]~=~tonumber("\lua_escape:e { \l__luareg_axis_xmax_tl }"),
            ["truncate"]~=~\bool_if:NTF \l__luareg_ci_truncate_bool { true } { false },
            ["ci_min"]~=~tonumber("\lua_escape:e { \l__luareg_ci_min_tl }"),
            ["ci_max"]~=~tonumber("\lua_escape:e { \l__luareg_ci_max_tl }"),
            ["seed"]~=~tonumber("\lua_escape:e { \l__luareg_seed_tl }"),
            ["ci_level"]~=~tonumber("\lua_escape:e { \l__luareg_ci_level_tl }"),
          }
        )
      }
  }

\ExplSyntaxOff

\makeatletter
\newcount\luareg@legendindex
\newcount\luareg@legendlast
\newcommand{\luaregappendlastlegendline}{%
    \pgfplotslistsize\pgfplots@plotspeclist\to\luareg@legendlast
    \ifnum\luareg@legendlast>0
        \advance\luareg@legendlast by -1
        \luareg@legendindex=0
        \def\luareg@newplotspecs{}%
        \pgfplotslistforeachungrouped\pgfplots@plotspeclist\as\luareg@entry{%
            \ifnum\luareg@legendindex=\luareg@legendlast
                \edef\luareg@entry{%
                    \luareg@entry,%
                    /pgfplots/every legend image post/.append style={%
                        /utils/exec={\noexpand\draw[color=\luaregressionlinecolor,thick] (0cm,0cm) -- (0.6cm,0cm);},%
                    }%
                }%
            \fi
            \expandafter\pgfplotslistpushback\expandafter{\luareg@entry}\to\luareg@newplotspecs
            \advance\luareg@legendindex by 1
        }%
        \global\let\pgfplots@plotspeclist\luareg@newplotspecs
    \fi
}
\makeatother

