% Helper conditionals for table vs file detection and numeric column indices
\prg_new_conditional:Npnn \__luareg_if_numeric:n #1 { TF }
  {
    \tl_set:Nx \l_tmpa_tl {#1}
    \exp_args:NnV \regex_match:nnTF { \A [0-9]+ \Z } \l_tmpa_tl
      { \prg_return_true: }
      { \prg_return_false: }
  }

\prg_new_conditional:Npnn \__luareg_if_control:n #1 { TF }
  {
    \tl_if_single_token:nTF {#1}
      {
        \token_if_cs:NTF #1
          { \prg_return_true: }
          { \prg_return_false: }
      }
      { \prg_return_false: }
  }

\NewDocumentCommand{\luaregressionifnumericTF}{mmm}
  { \__luareg_if_numeric:nTF {#1} {#2} {#3} }
\NewDocumentCommand{\luaregressionifcontrolTF}{mmm}
  { \__luareg_if_control:nTF {#1} {#2} {#3} }

