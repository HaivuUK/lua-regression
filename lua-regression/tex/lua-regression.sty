% Regression command
\NewDocumentCommand{\luareg}{O{}m}
  {
    \__luareg_reset_defaults:
    \keys_set:nn { luaregression } {#1}
    \tl_set_eq:NN \thiscicolor \l__luareg_ci_color_tl
    \tl_set_eq:NN \luaregressionlinecolor \l__luareg_linecolor_tl
    \tl_clear:N \l__luareg_axis_xmin_tl
    \tl_clear:N \l__luareg_axis_xmax_tl
    \cs_if_exist:NTF \pgfkeysvalueof
      {
        \tl_set:Nx \l__luareg_axis_xmin_tl { \pgfkeysvalueof{/pgfplots/xmin} }
        \tl_set:Nx \l__luareg_axis_xmax_tl { \pgfkeysvalueof{/pgfplots/xmax} }
      }
      { }
    \__luareg_if_control:nTF {#2}
      {
        \pgfplotstablegetrowsof{#2}
        \tl_set:Nx \l_tmpa_tl { \pgfplotsretval }
        \tl_set:Nx \l_tmpb_tl { \int_eval:n { \l_tmpa_tl - 1 } }
        \lua_now:n { luaregression_input_data = {} }
        \pgfplotsforeachungrouped \luaregressionrow in { 0, ..., \l_tmpb_tl }
          {
            \__luareg_if_numeric:nTF { \l__luareg_x_tl }
              {
                \pgfplotstablegetelem{\luaregressionrow}{[index]\int_eval:n { \l__luareg_x_tl - 1 }}\of{#2}
              }
              {
                \exp_args:NNV \pgfplotstablegetelem \luaregressionrow \l__luareg_x_tl \of{#2}
              }
            \tl_set_eq:NN \luaregressionxvalue \pgfplotsretval
            \__luareg_if_numeric:nTF { \l__luareg_y_tl }
              {
                \pgfplotstablegetelem{\luaregressionrow}{[index]\int_eval:n { \l__luareg_y_tl - 1 }}\of{#2}
              }
              {
                \exp_args:NNV \pgfplotstablegetelem \luaregressionrow \l__luareg_y_tl \of{#2}
              }
            \tl_set_eq:NN \luaregressionyvalue \pgfplotsretval
            \lua_now:e
              {
                luaregression_input_data[\luaregressionrow + 1]~=~{
                  tonumber("\lua_escape:e { \luaregressionxvalue }"),
                  tonumber("\lua_escape:e { \luaregressionyvalue }")
                }
              }
          }
        \__luareg_call_lua:n { luaregression_input_data }
        \lua_now:n { luaregression_input_data = nil }
      }
      {
        \__luareg_call_lua:n { "\lua_escape:e {#2}" }
      }
    \bool_if:NT \l__luareg_plot_bool
      {
        \cs_if_exist:NF \addplot
          {
            \msg_error:nn { lua-regression } { plot-outside-tikz }
          }
        \exp_args:NV \pgfplotsset \l__luareg_axis_pgf_tl
        \tl_if_eq:NnTF \l__luareg_legend_tl { last }
          {
            \use:e { \exp_not:N \addplot [ \exp_not:V \l__luareg_pgf_tl , forget~plot ] { \use:c { luareg@plot } }; }
            \luaregappendlastlegendline
          }
          {
            \bool_if:nTF
              {
                \l__luareg_eq_bool || \l__luareg_rsquared_bool || \l__luareg_p_bool
              }
              {
                \use:e { \exp_not:N \addplot [ \exp_not:V \l__luareg_pgf_tl ] { \use:c { luareg@plot } }; }
              }
              {
                \use:e { \exp_not:N \addplot [ \exp_not:V \l__luareg_pgf_tl , forget~plot ] { \use:c { luareg@plot } }; }
              }
            \tl_clear:N \l__luareg_legendentry_tl
            \bool_if:NT \l__luareg_eq_bool
              {
                \tl_set:Nx \l__luareg_legendentry_tl { $y = \use:c { luareg@printeq }$ }
              }
            \bool_if:NT \l__luareg_rsquared_bool
              {
                \tl_if_empty:NTF \l__luareg_legendentry_tl
                  { \tl_set:Nx \l__luareg_legendentry_tl { $R^2 = \use:c { luareg@polyR }$ } }
                  { \tl_put_right:Nx \l__luareg_legendentry_tl { ;~$R^2 = \use:c { luareg@polyR }$ } }
              }
            \bool_if:NT \l__luareg_p_bool
              {
                \tl_if_empty:NF \polyoverallp
                  {
                    \tl_if_empty:NTF \l__luareg_legendentry_tl
                      { \tl_set:Nx \l__luareg_legendentry_tl { $p = \polyoverallp$ } }
                      { \tl_put_right:Nx \l__luareg_legendentry_tl { ;~$p = \polyoverallp$ } }
                  }
              }
            \tl_if_empty:NF \l__luareg_legendentry_tl
              {
                \exp_args:NV \addlegendentryexpanded \l__luareg_legendentry_tl
              }
          }
        \bool_if:NT \l__luareg_ci_bool
          {
            \group_begin:
            \use:e
              {
                \exp_not:N \addplot [ forget~plot, name~path=qlwrpath, draw=none ]
                  coordinates { \use:c { luareg@qlwr } };
                \exp_not:N \addplot [ forget~plot, name~path=quprpath, draw=none ]
                  coordinates { \use:c { luareg@qupr } };
                \exp_not:N \addplot
                  [
                    forget~plot,
                    fill = \exp_not:V \l__luareg_ci_color_tl,
                    fill~opacity = \exp_not:V \l__luareg_ci_opacity_tl
                  ]
                  fill~between[of=quprpath~and~qlwrpath];
              }
            \group_end:
          }
      }
  }

