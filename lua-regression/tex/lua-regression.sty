\lua_now:n { require("lua-regression") }

% Internal and user-facing result macros
\msg_new:nnnn { lua-regression } { missing-result }
  { Missing~result~for~'#1' }
  {
    The~Lua~code~did~not~return~a~result~for~'#1'.~
    Please~check~your~datasource~and~ensure~that~it~returns~the~expected~values.
  }

\msg_new:nnnn { lua-regression } { plot-outside-tikz }
  { 'plot=true'~requires~a~tikzpicture~environment~and~pgfplots }
  { Use~'\token_to_str:N \begin{tikzpicture}...\token_to_str:N \end{tikzpicture}'~with~'\token_to_str:N \usepackage{pgfplots}'. }

\cs_new_protected:Npn \__luareg_missing_result:N #1
  {
    \msg_error:nnn { lua-regression } { missing-result } { \token_to_str:N #1 }
  }

\cs_set_eq:cN { luareg@missingresult } \__luareg_missing_result:N
\tl_gset:cn { luareg@polyR }   { \__luareg_missing_result:N \polyR }
\tl_gset:cn { luareg@polyeq }  { \__luareg_missing_result:N \polyeq }
\tl_gset:cn { luareg@printeq } { \__luareg_missing_result:N \printeq }
\tl_gset:cn { luareg@plot }    { \__luareg_missing_result:N \polyeq }
\tl_gclear_new:c { luareg@qlwr }
\tl_gclear_new:c { luareg@qupr }
\tl_clear_new:N \polypvalues
\tl_clear_new:N \polyoverallp

\NewDocumentCommand{\polyR}{}
